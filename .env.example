# Smart Traffic Signal — environment variables
# The simulation itself is fully client-side and needs none of these to run.
# They only affect metadata/SEO output. Copy this file to `.env.local` to override.

# Absolute origin used to build canonical URLs, Open Graph / Twitter card images,
# and sitemap.xml / robots.txt entries. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
